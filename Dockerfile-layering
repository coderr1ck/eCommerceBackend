# --- Stage 1: Build the JAR file ---
FROM maven:3.9.6-eclipse-temurin-17-alpine AS builder

WORKDIR /build

# Copy only pom.xml first
COPY pom.xml .

# Download dependencies separately to leverage true Docker layer caching
RUN mvn dependency:go-offline -B

# Copy source code and build the package
COPY src ./src

# Build without running unit tests
RUN mvn package -DskipTests -B


# --- Stage 2: Extract layers from jar for optimization ---
FROM eclipse-temurin:17-jre-alpine AS extractor

WORKDIR /app

COPY --from=builder /build/target/backend-0.0.1-SNAPSHOT.jar app.jar

# jarmode=tools 'extract' already splits into layers by default —
# there is no '--layers' flag in this mode (that was the older jarmode=layertools syntax)
RUN java -Djarmode=tools -jar app.jar extract --layers --destination extracted


# --- Stage 3: Create the lightweight runtime image with layers ordered by change frequency ---
FROM eclipse-temurin:17-jre-alpine AS runner

WORKDIR /app

# Dependencies layer changes rarely
COPY --from=extractor /app/extracted/dependencies/ ./

# Spring boot loader
COPY --from=extractor /app/extracted/spring-boot-loader/ ./

# Snapshot dependencies
COPY --from=extractor /app/extracted/snapshot-dependencies/ ./

# Application layer
COPY --from=extractor /app/extracted/application/ ./

# Expose Spring Boot's default port
EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]